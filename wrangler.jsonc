{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sakuracord-website",
  "account_id": "20aea060f70461a418cf31bc70b79cdc",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "sakuracord.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
